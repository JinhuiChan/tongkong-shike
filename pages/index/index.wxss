/* ---------- 品牌区 ---------- */
.hero {
  padding: 24rpx 8rpx 48rpx;
}

.hero__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero__title {
  flex: 1;
  min-width: 0;
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: -1.2rpx;
  line-height: 1.25;
  color: var(--ink);
}

.theme-toggle {
  flex-shrink: 0;
  margin-top: 8rpx;
  padding: 10rpx 20rpx;
  border: 2rpx solid var(--line-strong);
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.theme-toggle:active {
  background: var(--surface-3);
}

.hero__desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--ink-2);
  max-width: 600rpx;
}

.hero__meta {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.5rpx;
}

/* ---------- 主操作卡片 ---------- */
.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-card {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  box-shadow: var(--shadow);
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.action-card:active {
  transform: scale(0.99);
  opacity: 0.92;
}

.action-card--primary {
  background: var(--brand);
  box-shadow: 0 8rpx 28rpx rgba(79, 70, 229, 0.22);
}

.action-card--secondary {
  background: var(--surface);
}

.action-card__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 500;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.action-card--primary .action-card__icon {
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
}

.action-card--secondary .action-card__icon {
  background: var(--brand-soft);
  color: var(--brand);
}

.action-card__text {
  flex: 1;
  min-width: 0;
}

.action-card__title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
}

.action-card--primary .action-card__title {
  color: #fff;
}

.action-card__desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.action-card--primary .action-card__desc {
  color: rgba(255, 255, 255, 0.78);
}

.action-card--secondary .action-card__desc {
  color: var(--ink-3);
}

.action-card__arrow {
  flex-shrink: 0;
  font-size: 44rpx;
  line-height: 1;
  margin-left: 16rpx;
}

.action-card--primary .action-card__arrow {
  color: rgba(255, 255, 255, 0.6);
}

.action-card--secondary .action-card__arrow {
  color: var(--ink-3);
}

/* ---------- 区块标题 ---------- */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 48rpx 8rpx 20rpx;
}

.section-head__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.section-head__hint {
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ---------- 提示 ---------- */
.preview-note {
  background: #fff8e8;
  border: 2rpx solid #f6e2b8;
  color: #8a5a00;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.preview-note__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8a5a00;
}

.preview-note__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9a6b12;
}

.alert {
  display: flex;
  align-items: center;
  background: var(--warn-soft);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.alert__text {
  flex: 1;
  font-size: 24rpx;
  color: var(--warn-strong);
  line-height: 1.5;
}

.alert__action {
  margin-left: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--warn-strong);
  padding: 8rpx 16rpx;
}

/* ---------- 列表 ---------- */
.room-row {
  position: relative;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.room-delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--warn);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.room-item {
  position: relative;
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: var(--shadow);
  will-change: transform;
}

.room-item:active {
  background: var(--surface-hover);
}

.room-item__main {
  flex: 1;
  min-width: 0;
}

.room-item__title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.room-item__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.room-item__status {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--surface-3);
  color: var(--ink-3);
}

.room-item__status.is-filled {
  background: var(--ok-soft);
  color: var(--ok);
}

/* ---------- 空态 ---------- */
.empty-card {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 64rpx 40rpx;
  text-align: center;
  box-shadow: var(--shadow);
}

.empty-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.empty-card__desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-3);
}

.build-stamp {
  margin-top: 48rpx;
  padding-bottom: 16rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-3);
  letter-spacing: 0.5rpx;
}

/* ---------- 日期选择 ---------- */
.date-range {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.date-range__warn {
  color: var(--warn);
}

.date-links {
  display: flex;
  align-items: center;
}

.date-link {
  font-size: 22rpx;
  color: var(--brand);
  padding: 4rpx 0 4rpx 24rpx;
}

.date-strip {
  width: 100%;
  white-space: nowrap;
}

.date-chip {
  display: inline-block;
  width: 104rpx;
  padding: 16rpx 0;
  margin-right: 12rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  text-align: center;
}

.date-chip:last-child {
  margin-right: 0;
}

.date-chip:active {
  background: var(--surface-3);
}

.date-chip__week {
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--ink-3);
}

.date-chip__num {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.date-chip.is-active {
  background: var(--brand);
}

.date-chip.is-active .date-chip__week {
  color: rgba(255, 255, 255, 0.78);
}

.date-chip.is-active .date-chip__num {
  color: #fff;
}

/* ---------- 深色主题细节 ---------- */
.theme-dark .preview-note {
  background: #302814;
  border-color: #615025;
}

.theme-dark .preview-note__title {
  color: #f2d184;
}

.theme-dark .preview-note__desc {
  color: #d4b76d;
}

.theme-dark .action-card--secondary {
  border: 2rpx solid var(--line);
}

.theme-dark .room-item {
  border: 2rpx solid var(--line);
}
