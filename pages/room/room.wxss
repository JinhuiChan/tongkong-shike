.room-head {
  padding: 8rpx 8rpx 40rpx;
}

.head-link {
  font-size: 24rpx;
  color: var(--ink-3);
}

.title-row {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
}

.room-title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.3;
  word-break: break-all;
}

.rename-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 10rpx;
  padding: 8rpx 20rpx;
}

.rename-btn:active {
  opacity: 0.7;
}

/* ---------- 房号票券 ---------- */
.code-card {
  margin-top: 36rpx;
  background: var(--surface);
  border-radius: 24rpx;
  padding: 40rpx 32rpx 36rpx;
  text-align: center;
  box-shadow: var(--shadow);
}

.code-card__label {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 4rpx;
}

.code-card__value {
  margin-top: 8rpx;
  font-size: 76rpx;
  font-weight: 700;
  letter-spacing: 14rpx;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
  color: var(--ink);
}

.code-card__hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.code-card:active {
  background: var(--surface-hover);
}

/* ---------- 分享（主行动） ---------- */
.share-cta {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 100%;
  margin: 24rpx 0 0;
  padding: 26rpx 32rpx;
  background: var(--brand);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, 0.2);
  box-sizing: border-box;
  text-align: left;
}

.share-cta::after {
  border: none;
}

.share-cta:active {
  background: var(--brand-dark);
}

.share-cta__text {
  flex: 1;
  min-width: 0;
}

.share-cta__main {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.4;
}

.share-cta__sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.5;
}

.share-cta__arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 38rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.6);
}

/* ---------- 进度条 ---------- */
.progress {
  margin-top: 20rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: var(--surface-3);
  overflow: hidden;
}

.progress__bar {
  height: 100%;
  background: var(--brand);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

/* ---------- 成员 ---------- */
.member {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border-soft);
}

.member:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.member:first-child {
  padding-top: 24rpx;
}

.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.member__name {
  font-size: 30rpx;
  margin-left: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.me-tag {
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
}

.member__status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--surface-3);
  color: var(--ink-3);
  flex-shrink: 0;
}

.member__status.is-filled {
  background: var(--ok-soft);
  color: var(--ok);
}

.member-error {
  font-size: 24rpx;
  color: var(--warn);
  background: var(--warn-soft);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  text-align: center;
}

/* ---------- 删除 ---------- */
.danger-zone {
  margin-top: 56rpx;
  padding-bottom: 24rpx;
  text-align: center;
}

.danger-link {
  display: inline-block;
  font-size: 26rpx;
  color: var(--warn);
  padding: 16rpx 32rpx;
}

.danger-link:active {
  opacity: 0.6;
}

/* ---------- 底栏 ---------- */
.bar-row {
  display: flex;
  align-items: center;
}

.bar-btn-right {
  margin-left: 20rpx;
}

.error-state {
  padding: 160rpx 40rpx;
  text-align: center;
}

.error-state__text {
  font-size: 28rpx;
  color: var(--ink-2);
}

/* ---------- 深色主题细节 ---------- */
.theme-dark .code-card {
  border: 2rpx solid var(--line);
}

.theme-dark .code-card__value {
  color: var(--ink);
}

.theme-dark .share-cta {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.32);
}
